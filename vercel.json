{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(dashboard|orders|invoices|dispatch|payments|receivables|stock|purchases|suppliers|production|customers|products|reports|exports|settings|showcase|auth)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mill-ledger-194q.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell"
    }
  ]
}
