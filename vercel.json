{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mill-ledger-194q.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app-shell.html"
    }
  ]
}
