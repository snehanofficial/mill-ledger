ID_APPROVALS = new Set(['schema', 'permission', 'API', 'none']);\r\n\r\nconst ALLOWED_TRANSITIONS = {\r\n  OPEN: new Set(['IN-PROGRESS', 'BLOCKED', 'WONT-FIX']),\r\n  'IN-PROGRESS': new Set(['FIXED-UNVERIFIED', 'BLOCKED']),\r\n  'FIXED-UNVERIFIED': new Set(['VERIFIED', 'REJECTED']),\r\n  REJECTED: new Set(['IN-PROGRESS']),\r\n  VERIFIED: new Set(['REOPENED']),\r\n  REOPENED: new Set(['IN-PROGRESS']),\r\n  BLOCKED: new Set(['OPEN', 'IN-PROGRESS']),\r\n  'WONT-FIX': new Set(['OPEN']),\r\n};\r\n\r\nexport function generateMarkdown(items) {\r\n  const findings = items.filter((i) =\u003e !i.id.startsWith('CLUSTER-'));\r\n  const clusters = items.filter((i) =\u003e i.id.startsWith('CLUSTER-'));\r\n\r\n  const statusCounts = {};\r\n  const severityCounts = { P0: 0, P1: 0, P2: 0, P3: 0 };\r\n  const tierCounts = {};\r\n\r\n  for (const item of findings) {\r\n    statusCounts[item.status] = (statusCounts[item.status] ?? 0) + 1;\r\n    severityCounts[item.severity] = (severityCounts[item.severity] ?? 0) + 1;\r\n    tierCounts[item.tier] = (tierCounts[item.tier] ?? 0) + 1;\r\n  }\r\n\r\n  const verifiedCount = statusCounts['VERIFIED'] ?? 0;\r\n  const wontFixCount = statusCounts['WONT-FIX'] ?? 0;\r\n  const totalFindings = findings.length;\r\n  const progressPercent = totalFindings \u003e 0 ? (((verifiedCount + wontFixCount) / totalFindings) * 100).toFixed(1) : '0.0';\r\n\r\n  let md = `# MillLedger Remediation Work Tracker\r\n\r\n\u003e **Source of Truth**: \\`audit/tracker/tracker.json\\`  \r\n\u003e **Notice**: Do not edit this file manually. It is strictly generated by \\`check-tracker.mjs\\`.  \r\n\u003e **Last Updated**: 2026-11-20  \r\n\u003e **Progress**: ${verifiedCount + wontFixCount} / ${totalFindings} closed (${progressPercent}%)\r\n\r\n---\r\n\r\n## 1. Executive Status Summary\r\n\r\n### By Status\r\n| Status | Count | Percentage |\r\n|---|---|---|\r\n| OPEN | ${statusCounts['OPEN'] ?? 0} | ${(((statusCounts['OPEN'] ?? 0) / totalFindings) * 100).toFixed(1)}% |\r\n| IN-PROGRESS | ${statusCounts['IN-PROGRESS'] ?? 0} | ${(((statusCounts['IN-PROGRESS'] ?? 0) / totalFindings) * 100).toFixed(1)}% |\r\n| FIXED-UNVERIFIED | ${statusCounts['FIXED-UNVERIFIED'] ?? 0} | ${(((statusCounts['FIXED-UNVERIFIED'] ?? 0) / totalFindings) * 100).toFixed(1)}% |\r\n| VERIFIED | ${statusCounts['VERIFIED'] ?? 0} | ${(((statusCounts['VERIFIED'] ?? 0) / totalFindings) * 100).toFixed(1)}% |\r\n| BLOCKED | ${statusCounts['BLOCKED'] ?? 0} | ${(((statusCounts['BLOCKED'] ?? 0) / totalFindings) * 100).toFixed(1)}% |\r\n| WONT-FIX | ${statusCounts['WONT-FIX'] ?? 0} | ${(((statusCounts['WONT-FIX'] ?? 0) / totalFindings) * 100).toFixed(1)}% |\r\n| **TOTAL** | **${totalFindings}** | **100.0%** |\r\n\r\n### By Severity\r\n| Severity | Total | Open / In Progress | Verified / Closed |\r\n|---|---|---|---|\r\n| P0 (Blocker) | ${severityCounts['P0']} | ${findings.filter((i) =\u003e i.severity === 'P0' \u0026\u0026 i.status !== 'VERIFIED' \u0026\u0026 i.status !== 'WONT-FIX').length} | ${findings.filter((i) =\u003e i.severity === 'P0' \u0026\u0026 (i.status === 'VERIFIED' || i.status === 'WONT-FIX')).length} |\r\n| P1 (Critical) | ${severityCounts['P1']} | ${findings.filter((i) =\u003e i.severity === 'P1' \u0026\u0026 i.status !== 'VERIFIED' \u0026\u0026 i.status !== 'WONT-FIX').length} | ${findings.filter((i) =\u003e i.severity === 'P1' \u0026\u0026 (i.status === 'VERIFIED' || i.status === 'WONT-FIX')).length} |\r\n| P2 (Moderate) | ${severityCounts['P2']} | ${findings.filter((i) =\u003e i.severity === 'P2' \u0026\u0026 i.status !== 'VERIFIED' \u0026\u0026 i.status !== 'WONT-FIX').length} | ${findings.filter((i) =\u003e i.severity === 'P2' \u0026\u0026 (i.status === 'VERIFIED' || i.status === 'WONT-FIX')).length} |\r\n| P3 (Minor) | ${severityCounts['P3']} | ${findings.filter((i) =\u003e i.severity === 'P3' \u0026\u0026 i.status !== 'VERIFIED' \u0026\u0026 i.status !== 'WONT-FIX').length} | ${findings.filter((i) =\u003e i.severity === 'P3' \u0026\u0026 (i.status === 'VERIFIED' || i.status === 'WONT-FIX')).length} |\r\n\r\n---\r\n\r\n## 2. Blocked Work Items\r\n\r\n| ID | Title | Tier | Severity | Blocking Reason \u0026 Unblocking Action |\r\n|---|---|---|---|---|\r\n`;\r\n\r\n  const blocked = findings.filter((i) =\u003e i.status === 'BLOCKED');\r\n  if (blocked.length === 0) {\r\n    md += '| None | - | - | - | All items are eligible for processing |\\n';\r\n  } else {\r\n    for (const b of blocked) {\r\n      md += `| **${b.id}** | ${b.title} | ${b.tier} | ${b.severity} | ${b.notes.replace(/\\n/g, ' ')} |\\n`;\r\n    }\r\n  }\r\n\r\n  md += `\\n---\\n\\n## 3. Remediation Linear Work Queue (Topological Order)\\n\\n`;\r\n  md += `| ID | Tier | Sev | Cluster | Status | Approval | Depends On | Title |\\n`;\r\n  md += `|---|---|---|---|---|---|---|---|\\n`;\r\n\r\n  for (const item of findings) {\r\n    const deps = item.dependsOn?.length ? item.dependsOn.join(', ') : '-';\r\n    md += `| **${item.id}** | ${item.tier} | ${item.severity} | ${item.cluster} | \\`${item.status}\\` | ${item.needsApproval} | ${deps} | ${item.title} |\\n`;\r\n  }\r\n\r\n  return md;\r\n}\r\n\r\nexport function validateTracker(updateMd = false) {\r\n  if (!existsSync(TRACKER_JSON_PATH)) {\r\n    console.error(`FAIL: Tracker JSON not found at ${TRACKER_JSON_PATH}`);\r\n    process.exit(1);\r\n  }\r\n\r\n  let raw;\r\n  try {\r\n    raw = JSON.parse(readFileSync(TRACKER_JSON_PATH, 'utf8'));\r\n  } catch (err) {\r\n--\r\n      if (!hasApprovalNote) {\r\n        errors.push(`${prefix}: P0/P1 cannot be WONT-FIX without an 'owner-approved' note in notes or statusHistory`);\r\n      }\r\n    }\r\n\r\n    // VERIFIED checks\r\n    if (item.status === 'VERIFIED') {\r\n      if (!item.regressionTest || typeof item.regressionTest !== 'string') {\r\n        errors.push(`${prefix}: VERIFIED item requires a valid regressionTest path`);\r\n      }\r\n      if (!item.fixCommit || typeof item.fixCommit !== 'string') {\r\n        errors.push(`${prefix}: VERIFIED item requires fixCommit`);\r\n      }\r\n      if (!Array.isArray(item.verifyEvidence) || item.verifyEvidence.length \u003c 2) {\r\n        errors.push(`${prefix}: VERIFIED item requires verifyEvidence with before and after proof (\u003e= 2 entries)`);\r\n      }\r\n      if (!item.siblingSweep || !item.siblingSweep.done || !item.siblingSweep.queryUsed) {\r\n        errors.push(`${prefix}: VERIFIED item requires completed siblingSweep with queryUsed and done=true`);\r\n      }\r\n\r\n      // Verifier identity different from fixer session\r\n      const fixerEntry = (item.statusHistory || []).find((h) =\u003e h.status === 'FIXED-UNVERIFIED');\r\n      const verifierEntry = (item.statusHistory || []).find((h) =\u003e h.status === 'VERIFIED');\r\n      if (fixerEntry \u0026\u0026 verifierEntry \u0026\u0026 fixerEntry.session \u0026\u0026 verifierEntry.session \u0026\u0026 fixerEntry.session === verifierEntry.session) {\r\n        errors.push(`${prefix}: Verifier session '${verifierEntry.session}' must be distinct from fixer session '${fixerEntry.session}'`);\r\n      }\r\n    }\r\n  }\r\n\r\n  // Dependency graph checks\r\n  for (const item of items) {\r\n    if (item.status === 'IN-PROGRESS' || item.status === 'FIXED-UNVERIFIED' || item.status === 'VERIFIED') {\r\n      const deps = item.dependsOn || [];\r\n      for (const depId of deps) {\r\n        const dep = itemMap.get(depId);\r\n        if (!dep) {\r\n          errors.push(`Item '${item.id}': depends on non-existent item '${depId}'`);\r\n        } else if (dep.status !== 'VERIFIED' \u0026\u0026 dep.status !== 'WONT-FIX') {\r\n          errors.push(`Item '${item.id}': has status '${item.status}' but dependsOn item '${depId}' is '${dep.status}' (must be VERIFIED)`);\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  // Markdown synchronization check\r\n  const generatedMd = generateMarkdown(items);\r\n  if (updateMd || !existsSync(TRACKER_MD_PATH)) {\r\n    writeFileSync(TRACKER_MD_PATH, generatedMd, 'utf8');\r\n    console.log(`[check-tracker] Wrote synchronized tracker.md`);\r\n  } else {\r\n    const existingMd = readFileSync(TRACKER_MD_PATH, 'utf8');\r\n    if (existingMd !== generatedMd) {\r\n      errors.push(`tracker.md is out of date with tracker.json. Re-run check-tracker.mjs --generate-md to regenerate.`);\r\n    }\r\n  }\r\n\r\n  if (errors.length \u003e 0) {\r\n    console.error(`\\n❌ Tracker validation FAILED with ${errors.length} error(s):`);\r\n    for (const err of errors) {\r\n      console.error(`  - ${err}`);\r\n    }\r\n    process.exit(1);\r\n  }\r\n\r\n  console.log(`\\n✅ Tracker validation PASSED: ${items.length} work items cleanly verified.`);\r\n  return { ok: true, count: items.length };\r\n}\r\n\r\n// Direct execution\r\nif (process.argv[1] \u0026\u0026 fileURLToPath(import.meta.url) === process.argv[1]) {\r\n  const updateMd = process.argv.includes('--generate-md') || process.argv.includes('--update-md');\r\n  validateTracker(updateMd);\r\n}\r\n"}}}
