{"event":"step_update","step_update":{"conversation_id":"d1d157ef-42c4-407b-b317-a9e655f86d0d","step_index":18,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.284376373,"tool_info":{"name":"run_command","parameters":{"CommandLine":"ls -la audit/scripts/verify/ \u0026\u0026 head -n 30 audit/scripts/verify/*.sh"},"output":"Created At: 2026-11-22T21:21:05+05:30\nCompleted At: 2026-11-22T21:21:06+05:30\nCommand exited with code 0.\n\nCommand output:\ntotal 48\r\ndrwxrwxr-x 2 snehan snehan 4096 Nov 20 13:52 .\r\ndrwxrwxr-x 3 snehan snehan 4096 Nov 20 13:42 ..\r\n-rw-r--r-- 1 snehan snehan 2198 Nov 20 13:44 01-verify-fresh-env.sh\r\n-rw-r--r-- 1 snehan snehan 5786 Nov 20 13:48 02-repro-original.sh\r\n-rw-r--r-- 1 snehan snehan 2480 Nov 20 13:48 03-test-validity.sh\r\n-rw-r--r-- 1 snehan snehan 2924 Nov 20 13:49 04-mutation-check-file.sh\r\n-rw-r--r-- 1 snehan snehan 2599 Nov 20 13:49 04-mutation-check.sh\r\n-rw-r--r-- 1 snehan snehan 5298 Nov 20 13:51 05-adversarial-probes.sh\r\n-rw-r--r-- 1 snehan snehan 2697 Nov 20 13:52 06-sibling-sweep.sh\r\n-rw-r--r-- 1 snehan snehan  587 Nov 20 13:52 07-regression-radius.sh\r\n==\u003e audit/scripts/verify/01-verify-fresh-env.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/01-fresh-environment.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 1: FRESH ENVIRONMENT TEST FOR COMMIT af12729 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\nFRESH_DIR=\"/tmp/mill-ledger-fresh-f009\"\r\nDB_NAME=\"mill_ledger_fresh_f009\"\r\n\r\necho \"1. Cleaning up worktree and fresh database if any...\"\r\ncd /home/snehan/projects/web/mill-ledger\r\ngit worktree remove --force \"$FRESH_DIR\" 2\u003e/dev/null || rm -rf \"$FRESH_DIR\"\r\nPGPASSWORD=postgres dropdb -U postgres -h localhost --if-exists \"$DB_NAME\"\r\nPGPASSWORD=postgres createdb -U postgres -h localhost \"$DB_NAME\"\r\n\r\necho \"2. Checking out commit af12729 into clean directory $FRESH_DIR...\"\r\ngit worktree add --detach \"$FRESH_DIR\" af12729225d5acc2312118d99080a1c8a72f557f\r\n\r\ncd \"$FRESH_DIR\"\r\necho \"Current HEAD in fresh dir:\"\r\ngit rev-parse HEAD\r\ngit log -1 --oneline\r\n\r\necho \"3. Installing dependencies using frozen lockfile...\"\r\npnpm install --frozen-lockfile\r\n\r\necho \"4. Generating Prisma client...\"\r\npnpm --filter server prisma generate\r\n\r\n==\u003e audit/scripts/verify/02-repro-original.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/02-original-repro.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 2: ORIGINAL REPRO VERIFICATION FOR F-009 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\nDB=\"mill_ledger\"\r\nexport PGPASSWORD=postgres\r\n\r\necho \"--- 1. Testing original repro: UPDATE on stock_movement ---\"\r\nset +e\r\npsql -U postgres -h localhost -d \"$DB\" -c 'UPDATE \"stock_movement\" SET \"quantity\" = 0 WHERE id = (SELECT id FROM \"stock_movement\" LIMIT 1);'\r\nSM_UPDATE_EXIT=$?\r\nset -e\r\necho \"stock_movement UPDATE exit code: $SM_UPDATE_EXIT\"\r\n\r\necho \"--- 2. Testing DELETE on stock_movement ---\"\r\nset +e\r\npsql -U postgres -h localhost -d \"$DB\" -c 'DELETE FROM \"stock_movement\" WHERE id = (SELECT id FROM \"stock_movement\" LIMIT 1);'\r\nSM_DELETE_EXIT=$?\r\nset -e\r\necho \"stock_movement DELETE exit code: $SM_DELETE_EXIT\"\r\n\r\necho \"--- 3. Testing POSTED sales_invoice UPDATE and DELETE ---\"\r\npsql -U postgres -h localhost -d \"$DB\" -c \"\r\n  BEGIN;\r\n  SET LOCAL mill_ledger.bypass_immutability = 'on';\r\n  DELETE FROM sales_invoice_line WHERE \\\"invoiceId\\\" IN ('repro-inv-posted', 'repro-inv-draft');\r\n\r\n==\u003e audit/scripts/verify/03-test-validity.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/03-test-validity.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 3: TEST VALIDITY (REVERT CHECK) FOR F-009 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\nSCRATCH_DIR=\"/tmp/mill-ledger-revert-check-f009\"\r\nDB_NAME=\"mill_ledger_revert_check_f009\"\r\n\r\necho \"1. Cleaning up scratch directory and db...\"\r\ncd /home/snehan/projects/web/mill-ledger\r\ngit worktree remove --force \"$SCRATCH_DIR\" 2\u003e/dev/null || rm -rf \"$SCRATCH_DIR\"\r\nPGPASSWORD=postgres dropdb -U postgres -h localhost --if-exists \"$DB_NAME\"\r\nPGPASSWORD=postgres createdb -U postgres -h localhost \"$DB_NAME\"\r\n\r\necho \"2. Checking out af12729 into scratch worktree $SCRATCH_DIR...\"\r\ngit worktree add --detach \"$SCRATCH_DIR\" af12729225d5acc2312118d99080a1c8a72f557f\r\ncd \"$SCRATCH_DIR\"\r\n\r\necho \"3. Installing and generating prisma client in scratch worktree...\"\r\npnpm install --frozen-lockfile\r\npnpm --filter server prisma generate\r\n\r\nexport DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/${DB_NAME}?schema=public\"\r\n\r\necho \"4. Running baseline migrations (WITHOUT the F-009 migration)...\"\r\n# Revert ONLY the fix: remove the migration file/folder, and do not create triggers\r\nrm -rf server/prisma/migrations/20261120000002_ledger_immutability_triggers\r\n\r\n==\u003e audit/scripts/verify/04-mutation-check-file.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/04-mutation-check-file.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 4b: MUTATION CHECK WITH MUTATED MIGRATION FILE ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\nSCRATCH_DIR=\"/tmp/mill-ledger-mutant-f009\"\r\nDB_NAME=\"mill_ledger_mutant_f009\"\r\n\r\necho \"1. Cleaning up scratch directory and db...\"\r\ncd /home/snehan/projects/web/mill-ledger\r\ngit worktree remove --force \"$SCRATCH_DIR\" 2\u003e/dev/null || rm -rf \"$SCRATCH_DIR\"\r\nPGPASSWORD=postgres dropdb -U postgres -h localhost --if-exists \"$DB_NAME\"\r\nPGPASSWORD=postgres createdb -U postgres -h localhost \"$DB_NAME\"\r\n\r\necho \"2. Setting up scratch worktree...\"\r\ngit worktree add --detach \"$SCRATCH_DIR\" af12729225d5acc2312118d99080a1c8a72f557f\r\ncd \"$SCRATCH_DIR\"\r\npnpm install --frozen-lockfile\r\npnpm --filter server prisma generate\r\nexport DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/${DB_NAME}?schema=public\"\r\npnpm --filter server prisma migrate deploy\r\npnpm --filter server db:seed\r\n\r\necho \"3. Mutant A: Invert stock_movement UPDATE prohibition (allow UPDATE)\"\r\nsed -i 's/RAISE EXCEPTION '\\''Stock movements are immutable/RETURN NEW; --/' server/prisma/migrations/20261120000002_ledger_immutability_triggers/migration.sql\r\n\r\nset +e\r\n\r\n==\u003e audit/scripts/verify/04-mutation-check.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/04-mutation-check.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 4: MUTATION CHECK FOR F-009 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\nDB=\"mill_ledger\"\r\nexport PGPASSWORD=postgres\r\n\r\necho \"--- Mutation 1: Allow UPDATE on stock_movement (flip check to pass UPDATE) ---\"\r\npsql -U postgres -h localhost -d \"$DB\" -c \"\r\nCREATE OR REPLACE FUNCTION enforce_stock_movement_immutability()\r\nRETURNS TRIGGER AS \\$\\$\r\nBEGIN\r\n  IF TG_OP = 'UPDATE' THEN\r\n    RETURN NEW; -- MUTANT: Allows UPDATE\r\n  END IF;\r\n  RAISE EXCEPTION 'Stock movements are immutable: % on stock_movement is prohibited', TG_OP;\r\nEND;\r\n\\$\\$ LANGUAGE plpgsql;\r\n\"\r\n\r\nset +e\r\nnpx vitest run server/src/db-immutability.test.ts\r\nM1_EXIT=$?\r\nset -e\r\necho \"Mutant 1 test suite exit code: $M1_EXIT (expected non-zero if caught)\"\r\nif [ $M1_EXIT -ne 0 ]; then\r\n\r\n==\u003e audit/scripts/verify/05-adversarial-probes.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/05-adversarial-probes.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 5: ADVERSARIAL PROBES FOR F-009 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\nDB=\"mill_ledger\"\r\nexport PGPASSWORD=postgres\r\n\r\necho \"--- Setting up test invoice with POSTED status ---\"\r\npsql -U postgres -h localhost -d \"$DB\" -c \"\r\n  BEGIN;\r\n  SET LOCAL mill_ledger.bypass_immutability = 'on';\r\n  DELETE FROM sales_invoice_line WHERE \\\"invoiceId\\\" = 'adv-inv-posted';\r\n  DELETE FROM sales_invoice WHERE id = 'adv-inv-posted';\r\n  COMMIT;\r\n\"\r\n\r\npsql -U postgres -h localhost -d \"$DB\" -c \"\r\n  INSERT INTO sales_invoice (\r\n    id, \\\"organizationId\\\", \\\"invoiceNumber\\\", \\\"financialYear\\\", \\\"customerId\\\",\r\n    \\\"customerNameSnapshot\\\", \\\"deliveryStateSnapshot\\\", \\\"companyGstinSnapshot\\\",\r\n    status, \\\"taxableAmount\\\", \\\"cgstAmount\\\", \\\"sgstAmount\\\", \\\"igstAmount\\\",\r\n    \\\"totalTaxAmount\\\", \\\"totalAmount\\\", \\\"outstandingAmount\\\", \\\"createdAt\\\", \\\"updatedAt\\\"\r\n  ) VALUES (\r\n    'adv-inv-posted', (SELECT id FROM organization LIMIT 1), 'INV-ADV-POSTED-001', '2026-27',\r\n    (SELECT id FROM customer LIMIT 1), 'Original Customer Name', 'Tamil Nadu', '33AAAAA0000A1Z5',\r\n    'POSTED', 100, 2.5, 2.5, 0, 5, 105, 105, NOW(), NOW()\r\n\r\n==\u003e audit/scripts/verify/06-sibling-sweep.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/06-sibling-sweep.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 6: SIBLING SWEEP AUDIT FOR F-009 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\necho \"--- 1. Searching for DELETE/DELETEMANY across all server code (excluding test files and seeds) ---\"\r\ngit grep -n -E '\\.(delete|deleteMany)\\(' server/src/modules/ || true\r\n\r\necho \"--- 2. Searching for direct raw SQL UPDATE/DELETE in server code ---\"\r\ngit grep -n -i -E '\\$(executeRaw|queryRaw).*([[:space:]](DELETE|UPDATE)[[:space:]])' server/src/ || true\r\n\r\necho \"--- 3. Checking other immutable ledger tables in PostgreSQL for missing triggers ---\"\r\necho \"Tables in database that represent financial/audit/movement records:\"\r\nexport PGPASSWORD=postgres\r\npsql -U postgres -h localhost -d mill_ledger -c \"\r\nSELECT table_name \r\nFROM information_schema.tables \r\nWHERE table_schema = 'public' \r\n  AND table_name IN (\r\n    'stock_movement', 'sales_invoice', 'sales_invoice_line', \r\n    'audit_log', 'payment', 'payment_allocation', 'credit_note', \r\n    'purchase_receipt', 'production_run'\r\n  );\r\n\"\r\n\r\necho \"User-defined triggers currently present in database:\"\r\npsql -U postgres -h localhost -d mill_ledger -c \"\r\n\r\n==\u003e audit/scripts/verify/07-regression-radius.sh \u003c==\r\n#!/usr/bin/env bash\r\nset -e\r\n\r\nexec \u003e audit/evidence/verify/F-009/07-regression-radius.txt 2\u003e\u00261\r\n\r\necho \"=== STEP 7: REGRESSION RADIUS CHECKS FOR F-009 ===\"\r\necho \"Timestamp: $(date -Iseconds)\"\r\n\r\necho \"--- 1. Running Benchmark ---\"\r\npnpm benchmark\r\n\r\necho \"--- 2. Running Invariants Check ---\"\r\nPGPASSWORD=postgres psql -U postgres -h localhost -d mill_ledger -f audit/scripts/invariants.sql\r\n\r\necho \"--- 3. Running Unit and Integration Test Suite ---\"\r\npnpm test\r\n\r\necho \"--- 4. Running Typecheck ---\"\r\npnpm typecheck\r\n\r\necho \"--- 5. Running Lint ---\"\r\npnpm lint\r\n\r\necho \"=== REGRESSION RADIUS COMPLETE ===\"\r\n"}}}
