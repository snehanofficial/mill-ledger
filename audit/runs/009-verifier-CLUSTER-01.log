ormatINR(1000)).toBe(\"₹1,000.00\");\r\n+      expect(formatINR(7875.5)).toBe(\"₹7,875.50\");\r\n+      expect(formatINR(0)).toBe(\"₹0.00\");\r\n+    });\r\n+\r\n+    it(\"correctly groups Lakhs and Crores using Indian numbering system\", () =\u003e {\r\n+      // 1 Lakh = 1,00,000.00\r\n+      expect(formatINR(100000)).toBe(\"₹1,00,000.00\");\r\n+      // 12.5 Lakhs = 12,50,000.00\r\n+      expect(formatINR(1250000)).toBe(\"₹12,50,000.00\");\r\n+      // 1 Crore = 1,00,00,000.00\r\n+      expect(formatINR(10000000)).toBe(\"₹1,00,00,000.00\");\r\n+      // Complex multi-digit financial amount\r\n+      expect(formatINR(12345678.9)).toBe(\"₹1,23,45,678.90\");\r\n+    });\r\n+\r\n+    it(\"handles string representations of numbers\", () =\u003e {\r\n+      expect(formatINR(\"1000\")).toBe(\"₹1,000.00\");\r\n+      expect(formatINR(\"100000.50\")).toBe(\"₹1,00,000.50\");\r\n+      expect(formatINR(\"7875\")).toBe(\"₹7,875.00\");\r\n+    });\r\n+\r\n+    it(\"handles Decimal-like objects with toString() or toNumber()\", () =\u003e {\r\n+      const mockDecimal = {\r\n+        toString: () =\u003e \"4000.00\",\r\n+        toNumber: () =\u003e 4000,\r\n+      };\r\n+      expect(formatINR(mockDecimal)).toBe(\"₹4,000.00\");\r\n+    });\r\n+\r\n+    it(\"formats negative amounts correctly with minus sign\", () =\u003e {\r\n+      expect(formatINR(-500)).toBe(\"-₹500.00\");\r\n+      expect(formatINR(-100000)).toBe(\"-₹1,00,000.00\");\r\n+    });\r\n+\r\n+    it(\"gracefully falls back on null, undefined, NaN, and invalid strings\", () =\u003e {\r\n+      expect(formatINR(null)).toBe(\"₹0.00\");\r\n+      expect(formatINR(undefined)).toBe(\"₹0.00\");\r\n+      expect(formatINR(NaN)).toBe(\"₹0.00\");\r\n+      expect(formatINR(\"invalid-amount\")).toBe(\"₹0.00\");\r\n+    });\r\n+\r\n+    it(\"supports optional configuration (e.g. symbol: false)\", () =\u003e {\r\n+      expect(formatINR(100000, { symbol: false })).toBe(\"1,00,000.00\");\r\n+      expect(formatINR(500, { minimumFractionDigits: 0, maximumFractionDigits: 0 })).to\n\u003ctruncated 58451 of 68343 bytes from the middle of the output\u003e\n\r\n+ * Canonical Currency and Date/Time Formatters for MillLedger.\r\n+ * Adheres to Indian Accounting ERP standards (en-IN locale, Section 170 CGST Act).\r\n+ */\r\n+\r\n+export interface FormatINROptions {\r\n+  symbol?: boolean;\r\n+  minimumFractionDigits?: number;\r\n+  maximumFractionDigits?: number;\r\n+  fallback?: string;\r\n+}\r\n+\r\n+export interface FormatQuantityOptions {\r\n+  unit?: string;\r\n+  minimumFractionDigits?: number;\r\n+  maximumFractionDigits?: number;\r\n+  fallback?: string;\r\n+}\r\n+\r\n+/**\r\n+ * Format a number, string, or Decimal-like value into Indian Rupees (INR)\r\n+ * following Indian grouping standards (Lakhs, Crores) with 2 decimal places.\r\n+ * Example: 100000 -\u003e ₹1,00,000.00\r\n+ */\r\n+export function formatINR(\r\n+  amount: number | string | { toString(): string } | null | undefined,\r\n+  options: FormatINROptions = {}\r\n+): string {\r\n+  const {\r\n+    symbol = true,\r\n+    minimumFractionDigits = 2,\r\n+    maximumFractionDigits = 2,\r\n+    fallback = \"₹0.00\",\r\n+  } = options;\r\n+\r\n+  if (amount === null || amount === undefined) {\r\n+    return symbol ? fallback : \"0.00\";\r\n+  }\r\n+\r\n+  let num: number;\r\n+  if (typeof amount === \"number\") {\r\n+    num = amount;\r\n+  } else if (typeof amount === \"string\") {\r\n+    num = Number(amount.trim());\r\n+  } else if (typeof amount === \"object\" \u0026\u0026 typeof amount.toString === \"function\") {\r\n+    num = Number(amount.toString().trim());\r\n+  } else {\r\n+    num = Number(amount);\r\n+  }\r\n+\r\n+  if (Number.isNaN(num) || !Number.isFinite(num)) {\r\n+    return symbol ? fallback : \"0.00\";\r\n+  }\r\n+\r\n+  if (symbol) {\r\n+    return new Intl.NumberFormat(\"en-IN\", {\r\n+      style: \"currency\",\r\n+      currency: \"INR\",\r\n+      minimumFractionDigits,\r\n+      maximumFractionDigits,\r\n+    }).format(num);\r\n+  }\r\n+\r\n+  return new Intl.NumberFormat(\"en-IN\", {\r\n+    minimumFractionDigits,\r\n+    maximumFractionDigits,\r\n+  }).format(num);\r\n+}\r\n+\r\n+/**\r\n+ * Format a discrete quantity or count with Indian number grouping.\r\n+ * Example: 100000, unit \"pkts\" -\u003e \"1,00,000 pkts\"\r\n+ */\r\n+export function formatQuantity(\r\n+  amount: number | string | { toString(): string } | null | undefined,\r\n+  options: FormatQuantityOptions = {}\r\n+): string {\r\n+  const {\r\n+    unit,\r\n+    minimumFractionDigits = 0,\r\n+    maximumFractionDigits = 2,\r\n+    fallback = \"0\",\r\n+  } = options;\r\n+\r\n+  if (amount === null || amount === undefined) {\r\n+    return unit ? `${fallback} ${unit}` : fallback;\r\n+  }\r\n+\r\n+  let num: number;\r\n+  if (typeof amount === \"number\") {\r\n+    num = amount;\r\n+  } else if (typeof amount === \"string\") {\r\n+    num = Number(amount.trim());\r\n+  } else if (typeof amount === \"object\" \u0026\u0026 typeof amount.toString === \"function\") {\r\n+    num = Number(amount.toString().trim());\r\n+  } else {\r\n+    num = Number(amount);\r\n+  }\r\n+\r\n+  if (Number.isNaN(num) || !Number.isFinite(num)) {\r\n+    return unit ? `${fallback} ${unit}` : fallback;\r\n+  }\r\n+\r\n+  const formatted = new Intl.NumberFormat(\"en-IN\", {\r\n+    minimumFractionDigits,\r\n+    maximumFractionDigits,\r\n+  }).format(num);\r\n+\r\n+  return unit ? `${formatted} ${unit}` : formatted;\r\n+}\r\n+\r\n+/**\r\n+ * Format a date into Indian standard format (DD MMM YYYY, e.g. 01 Apr 2026).\r\n+ */\r\n+export function formatDate(\r\n+  date: string | Date | number | null | undefined,\r\n+  options: Intl.DateTimeFormatOptions = {\r\n+    day: \"2-digit\",\r\n+    month: \"short\",\r\n+    year: \"numeric\",\r\n+  }\r\n+): string {\r\n+  if (!date) return \"—\";\r\n+  const d = date instanceof Date ? date : new Date(date);\r\n+  if (Number.isNaN(d.getTime())) return \"—\";\r\n+\r\n+  return new Intl.DateTimeFormat(\"en-IN\", options).format(d);\r\n+}\r\n+\r\n+/**\r\n+ * Format a date into short Indian standard format (DD/MM/YYYY, e.g. 01/04/2026).\r\n+ */\r\n+export function formatDateShort(\r\n+  date: string | Date | number | null | undefined\r\n+): string {\r\n+  return formatDate(date, {\r\n+    day: \"2-digit\",\r\n+    month: \"2-digit\",\r\n+    year: \"numeric\",\r\n+  });\r\n+}\r\n+\r\n+/**\r\n+ * Format date and time in Indian Standard Time (IST) convention.\r\n+ */\r\n+export function formatDateTime(\r\n+  date: string | Date | number | null | undefined,\r\n+  options: Intl.DateTimeFormatOptions = {\r\n+    day: \"2-digit\",\r\n+    month: \"short\",\r\n+    year: \"numeric\",\r\n+    hour: \"2-digit\",\r\n+    minute: \"2-digit\",\r\n+    hour12: true,\r\n+  }\r\n+): string {\r\n+  return formatDate(date, options);\r\n+}\r\n+\r\n+/**\r\n+ * Format time in Indian convention (e.g. 03:30 pm).\r\n+ */\r\n+export function formatTime(\r\n+  date: string | Date | number | null | undefined,\r\n+  options: Intl.DateTimeFormatOptions = {\r\n+    hour: \"2-digit\",\r\n+    minute: \"2-digit\",\r\n+    hour12: true,\r\n+  }\r\n+): string {\r\n+  return formatDate(date, options);\r\n+}\r\ndiff --git a/shared/src/index.ts b/shared/src/index.ts\r\nindex d4267c1..eaf11ea 100644\r\n--- a/shared/src/index.ts\r\n+++ b/shared/src/index.ts\r\n@@ -1,3 +1,4 @@\r\n export * from \"./contracts/index.js\";\r\n export * from \"./schemas/index.js\";\r\n export * from \"./types/index.js\";\r\n+export * from \"./formatters.js\";\r\n"}}}
