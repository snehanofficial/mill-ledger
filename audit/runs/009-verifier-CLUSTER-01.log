{"event":"step_update","step_update":{"conversation_id":"d1d157ef-42c4-407b-b317-a9e655f86d0d","step_index":29,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.560718625,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git show --stat e0047aa \u0026\u0026 git show e0047aa:shared/src/formatters.ts \u0026\u0026 git show e0047aa:client/src/lib/formatters.ts"},"output":"Created At: 2026-11-22T21:21:30+05:30\nCompleted At: 2026-11-22T21:21:31+05:30\nCommand exited with code 0.\n\nCommand output:\ncommit e0047aadb565ba164ff07f8ad499b6c8b5bbe988 (HEAD -\u003e remediation/main)\r\nAuthor: Snehan S \u003csnehankgs@gmail.com\u003e\r\nDate:   Sun Nov 22 21:18:29 2026 +0530\r\n\r\n    F-097: Architectural Inconsistency: Zero Centralized Currency \u0026 Date Formatters across 7 Financial Surfaces (Ad-hoc .toFixed(2) \u0026 Fragmented Locales)\r\n\r\n .../src/components/shell/device-outbox-sheet.tsx   |  11 +-\r\n client/src/lib/formatters.test.ts                  | 117 ++++++++++++++\r\n client/src/lib/formatters.ts                       |   4 +\r\n client/src/pages/dashboard-page.tsx                |  43 ++----\r\n client/src/pages/dispatch-page.tsx                 |  10 +-\r\n client/src/pages/invoices-page.tsx                 |  58 +++----\r\n client/src/pages/orders-page.tsx                   |  46 +++---\r\n client/src/pages/payments-page.tsx                 |  84 +++-------\r\n client/src/pages/production-page.tsx               |  36 ++---\r\n client/src/pages/purchases-page.tsx                |  15 +-\r\n client/src/pages/reports-page.tsx                  |  70 ++++-----\r\n client/src/pages/stock-page.tsx                    |  21 +--\r\n shared/package.json                                |   3 +-\r\n shared/src/formatters.ts                           | 172 +++++++++++++++++++++\r\n shared/src/index.ts                                |   1 +\r\n 15 files changed, 443 insertions(+), 248 deletions(-)\r\n/**\r\n * Canonical Currency and Date/Time Formatters for MillLedger.\r\n * Adheres to Indian Accounting ERP standards (en-IN locale, Section 170 CGST Act).\r\n */\r\n\r\nexport interface FormatINROptions {\r\n  symbol?: boolean;\r\n  minimumFractionDigits?: number;\r\n  maximumFractionDigits?: number;\r\n  fallback?: string;\r\n}\r\n\r\nexport interface FormatQuantityOptions {\r\n  unit?: string;\r\n  minimumFractionDigits?: number;\r\n  maximumFractionDigits?: number;\r\n  fallback?: string;\r\n}\r\n\r\n/**\r\n * Format a number, string, or Decimal-like value into Indian Rupees (INR)\r\n * following Indian grouping standards (Lakhs, Crores) with 2 decimal places.\r\n * Example: 100000 -\u003e ₹1,00,000.00\r\n */\r\nexport function formatINR(\r\n  amount: number | string | { toString(): string } | null | undefined,\r\n  options: FormatINROptions = {}\r\n): string {\r\n  const {\r\n    symbol = true,\r\n    minimumFractionDigits = 2,\r\n    maximumFractionDigits = 2,\r\n    fallback = \"₹0.00\",\r\n  } = options;\r\n\r\n  if (amount === null || amount === undefined) {\r\n    return symbol ? fallback : \"0.00\";\r\n  }\r\n\r\n  let num: number;\r\n  if (typeof amount === \"number\") {\r\n    num = amount;\r\n  } else if (typeof amount === \"string\") {\r\n    num = Number(amount.trim());\r\n  } else if (typeof amount === \"object\" \u0026\u0026 typeof amount.toString === \"function\") {\r\n    num = Number(amount.toString().trim());\r\n  } else {\r\n    num = Number(amount);\r\n  }\r\n\r\n  if (Number.isNaN(num) || !Number.isFinite(num)) {\r\n    return symbol ? fallback : \"0.00\";\r\n  }\r\n\r\n  if (symbol) {\r\n    return new Intl.NumberFormat(\"en-IN\", {\r\n      style: \"currency\",\r\n      currency: \"INR\",\r\n      minimumFractionDigits,\r\n      maximumFractionDigits,\r\n    }).format(num);\r\n  }\r\n\r\n  return new Intl.NumberFormat(\"en-IN\", {\r\n    minimumFractionDigits,\r\n    maximumFractionDigits,\r\n  }).format(num);\r\n}\r\n\r\n/**\r\n * Format a discrete quantity or count with Indian number grouping.\r\n * Example: 100000, unit \"pkts\" -\u003e \"1,00,000 pkts\"\r\n */\r\nexport function formatQuantity(\r\n  amount: number | string | { toString(): string } | null | undefined,\r\n  options: FormatQuantityOptions = {}\r\n): string {\r\n  const {\r\n    unit,\r\n    minimumFractionDigits = 0,\r\n    maximumFractionDigits = 2,\r\n    fallback = \"0\",\r\n  } = options;\r\n\r\n  if (amount === null || amount === undefined) {\r\n    return unit ? `${fallback} ${unit}` : fallback;\r\n  }\r\n\r\n  let num: number;\r\n  if (typeof amount === \"number\") {\r\n    num = amount;\r\n  } else if (typeof amount === \"string\") {\r\n    num = Number(amount.trim());\r\n  } else if (typeof amount === \"object\" \u0026\u0026 typeof amount.toString === \"function\") {\r\n    num = Number(amount.toString().trim());\r\n  } else {\r\n    num = Number(amount);\r\n  }\r\n\r\n  if (Number.isNaN(num) || !Number.isFinite(num)) {\r\n    return unit ? `${fallback} ${unit}` : fallback;\r\n  }\r\n\r\n  const formatted = new Intl.NumberFormat(\"en-IN\", {\r\n    minimumFractionDigits,\r\n    maximumFractionDigits,\r\n  }).format(num);\r\n\r\n  return unit ? `${formatted} ${unit}` : formatted;\r\n}\r\n\r\n/**\r\n * Format a date into Indian standard format (DD MMM YYYY, e.g. 01 Apr 2026).\r\n */\r\nexport function formatDate(\r\n  date: string | Date | number | null | undefined,\r\n  options: Intl.DateTimeFormatOptions = {\r\n    day: \"2-digit\",\r\n    month: \"short\",\r\n    year: \"numeric\",\r\n  }\r\n): string {\r\n  if (!date) return \"—\";\r\n  const d = date instanceof Date ? date : new Date(date);\r\n  if (Number.isNaN(d.getTime())) return \"—\";\r\n\r\n  return new Intl.DateTimeFormat(\"en-IN\", options).format(d);\r\n}\r\n\r\n/**\r\n * Format a date into short Indian standard format (DD/MM/YYYY, e.g. 01/04/2026).\r\n */\r\nexport function formatDateShort(\r\n  date: string | Date | number | null | undefined\r\n): string {\r\n  return formatDate(date, {\r\n    day: \"2-digit\",\r\n    month: \"2-digit\",\r\n    year: \"numeric\",\r\n  });\r\n}\r\n\r\n/**\r\n * Format date and time in Indian Standard Time (IST) convention.\r\n */\r\nexport function formatDateTime(\r\n  date: string | Date | number | null | undefined,\r\n  options: Intl.DateTimeFormatOptions = {\r\n    day: \"2-digit\",\r\n    month: \"short\",\r\n    year: \"numeric\",\r\n    hour: \"2-digit\",\r\n    minute: \"2-digit\",\r\n    hour12: true,\r\n  }\r\n): string {\r\n  return formatDate(date, options);\r\n}\r\n\r\n/**\r\n * Format time in Indian convention (e.g. 03:30 pm).\r\n */\r\nexport function formatTime(\r\n  date: string | Date | number | null | undefined,\r\n  options: Intl.DateTimeFormatOptions = {\r\n    hour: \"2-digit\",\r\n    minute: \"2-digit\",\r\n    hour12: true,\r\n  }\r\n): string {\r\n  return formatDate(date, options);\r\n}\r\n/**\r\n * Re-export canonical formatters for client consumption via \"@/lib/formatters\".\r\n */\r\nexport * from \"@mill-ledger/shared\";\r\n"}}}
