N\r\n+  IF current_setting('mill_ledger.bypass_immutability', true) = 'on' THEN\r\n+    IF TG_OP = 'DELETE' THEN\r\n+      RETURN OLD;\r\n+    ELSE\r\n+      RETURN NEW;\r\n+    END IF;\r\n+  END IF;\r\n+\r\n+  RAISE EXCEPTION 'Stock movements are immutable: % on stock_movement is prohibited', TG_OP;\r\n+END;\r\n+$$ LANGUAGE plpgsql;\r\n+\r\n+DROP TRIGGER IF EXISTS trg_stock_movement_immutable ON \"stock_movement\";\r\n+CREATE TRIGGER trg_stock_movement_immutable\r\n+BEFORE UPDATE OR DELETE ON \"stock_movement\"\r\n+FOR EACH ROW EXECUTE FUNCTION enforce_stock_movement_immutability();\r\n+\r\n+-- Trigger to enforce immutability on posted sales_invoice\r\n+CREATE OR REPLACE FUNCTION enforce_sales_invoice_immutability()\r\n+RETURNS TRIGGER AS $$\r\n+BEGIN\r\n+  IF current_setting('mill_ledger.bypass_immutability', true) = 'on' THEN\r\n+    IF TG_OP = 'DELETE' THEN\r\n+      RETURN OLD;\r\n+    ELSE\r\n+      RETURN NEW;\r\n+    END IF;\r\n+  END IF;\r\n+\r\n+  IF TG_OP = 'DELETE' THEN\r\n+    IF OLD.status IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') THEN\r\n+      RAISE EXCEPTION 'Posted sales invoices cannot be deleted (status: %)', OLD.status;\r\n+    END IF;\r\n+    RETURN OLD;\r\n+  END IF;\r\n+\r\n+  IF TG_OP = 'UPDATE' THEN\r\n+    IF OLD.status IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') THEN\r\n+      IF (OLD.\"totalAmount\" IS DISTINCT FROM NEW.\"totalAmount\") OR\r\n+         (OLD.\"taxableAmount\" IS DISTINCT FROM NEW.\"taxableAmount\") OR\r\n+         (OLD.\"cgstAmount\" IS DISTINCT FROM NEW.\"cgstAmount\") OR\r\n+         (OLD.\"sgstAmount\" IS DISTINCT FROM NEW.\"sgstAmount\") OR\r\n+         (OLD.\"igstAmount\" IS DISTINCT FROM NEW.\"igstAmount\") OR\r\n+         (OLD.\"totalTaxAmount\" IS DISTINCT FROM NEW.\"totalTaxAmount\") OR\r\n+         (OLD.\"invoiceNumber\" IS DISTINCT FROM NEW.\"invoiceNumber\") OR\r\n+         (OLD.\"financialYear\" IS DISTINCT FROM NEW.\"financialYear\") OR\r\n+         (OLD.\"customerId\" IS DISTINCT FROM NEW.\"customerId\") OR\r\n+         (OLD.\"organizationId\" IS DISTINCT FROM NEW.\"organizationId\") THEN\r\n+        RAISE EXCEPTION 'Posted sales invoice financial and identification fields are immutable';\r\n+      END IF;\r\n+    END IF;\r\n+    RETURN NEW;\r\n+  END IF;\r\n+\r\n+  RETURN NEW;\r\n+END;\r\n+$$ LANGUAGE plpgsql;\r\n+\r\n+DROP TRIGGER IF EXISTS trg_sales_invoice_immutable ON \"sales_invoice\";\r\n+CREATE TRIGGER trg_sales_invoice_immutable\r\n+BEFORE UPDATE OR DELETE ON \"sales_invoice\"\r\n+FOR EACH ROW EXECUTE FUNCTION enforce_sales_invoice_immutability();\r\n+\r\n+-- Trigger to enforce immutability on lines of posted sales_invoice\r\n+CREATE OR REPLACE FUNCTION enforce_sales_invoice_line_immutability()\r\n+RETURNS TRIGGER AS $$\r\n+DECLARE\r\n+  v_status TEXT;\r\n+BEGIN\r\n+  IF current_setting('mill_ledger.bypass_immutability', true) = 'on' THEN\r\n+    IF TG_OP = 'DELETE' THEN\r\n+      RETURN OLD;\r\n+    ELSE\r\n+      RETURN NEW;\r\n+    END IF;\r\n+  END IF;\r\n+\r\n+  SELECT status INTO v_status FROM \"sales_invoice\" WHERE id = COALESCE(OLD.\"salesInvoiceId\", NEW.\"salesInvoiceId\");\r\n+  IF v_status IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') THEN\r\n+    RAISE EXCEPTION 'Lines belonging to posted sales invoices are immutable';\r\n+  END IF;\r\n+\r\n+  IF TG_OP = 'DELETE' THEN\r\n+    RETURN OLD;\r\n+  ELSE\r\n+    RETURN NEW;\r\n+  END IF;\r\n+END;\r\n+$$ LANGUAGE plpgsql;\r\n+\r\n+DROP TRIGGER IF EXISTS trg_sales_invoice_line_immutable ON \"sales_invoice_line\";\r\n+CREATE TRIGGER trg_sales_invoice_line_immutable\r\n+BEFORE UPDATE OR DELETE ON \"sales_invoice_line\"\r\n+FOR EACH ROW EXECUTE FUNCTION enforce_sales_invoice_line_immutability();\r\ndiff --git a/server/src/db-immutability.test.ts b/server/src/db-immutability.test.ts\r\nnew file mode 100644\r\nindex 0000000..24bddf3\r\n--- /dev/null\r\n+++ b/server/src/db-immutability.test.ts\r\n@@ -0,0 +1,98 @@\r\n+import { afterAll, describe, expect, it } from \"vitest\";\r\n+import { prisma } from \"./db/client.js\";\r\n+import { resetOperationalData } from \"./db/reset.js\";\r\n+\r\n+describe(\"F-009: Database-Level Immutability Enforcement\", () =\u003e {\r\n+  afterAll(async () =\u003e {\r\n+    await resetOperationalData();\r\n+  });\r\n+  it(\"rejects direct SQL UPDATE on stock_movement\", async () =\u003e {\r\n+    const sm = await prisma.stockMovement.findFirst();\r\n+    expect(sm).toBeDefined();\r\n+    if (!sm) return;\r\n+\r\n+    await expect(\r\n+      prisma.$executeRaw`UPDATE \"stock_movement\" SET \"quantity\" = 999.000000 WHERE \"id\" = ${sm.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+\r\n+  it(\"rejects direct SQL DELETE on stock_movement\", async () =\u003e {\r\n+    // Create a temporary movement to attempt deleting\r\n+    const item = await prisma.inventoryItem.findFirstOrThrow();\r\n+    const wh = await prisma.warehouse.findFirstOrThrow();\r\n+\r\n+    const tempSm = await prisma.stockMovement.create({\r\n+      data: {\r\n+        inventoryItemId: item.id,\r\n+        warehouseId: wh.id,\r\n+        movementType: \"ADJUSTMENT\",\r\n+        quantity: 1,\r\n+        unitCost: 10,\r\n+        totalCost: 10,\r\n+        notes: \"TEST-DELETE-REF\",\r\n+      },\r\n+    });\r\n+\r\n+    await expect(\r\n+      prisma.$executeRaw`DELETE FROM \"stock_movement\" WHERE \"id\" = ${tempSm.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+\r\n+  it(\"rejects direct SQL UPDATE of financial totals on POSTED sales_invoice\", async () =\u003e {\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    const cust = await prisma.customer.findFirstOrThrow();\r\n+\r\n+    const testInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: org.id,\r\n+        invoiceNumber: `INV-IMMUTABLE-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: cust.id,\r\n+        customerNameSnapshot: cust.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 5,\r\n+        totalAmount: 105,\r\n+        outstandingAmount: 105,\r\n+      },\r\n+    });\r\n+\r\n+    await expect(\r\n+      prisma.$executeRaw`UPDATE \"sales_invoice\" SET \"totalAmount\" = 9999.00 WHERE \"id\" = ${testInv.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+\r\n+  it(\"rejects direct SQL DELETE on POSTED sales_invoice\", async () =\u003e {\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    const cust = await prisma.customer.findFirstOrThrow();\r\n+\r\n+    const testInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: org.id,\r\n+        invoiceNumber: `INV-DEL-IMMUTABLE-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: cust.id,\r\n+        customerNameSnapshot: cust.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 5,\r\n+        totalAmount: 105,\r\n+        outstandingAmount: 105,\r\n+      },\r\n+    });\r\n+\r\n+    await expect(\r\n+      prisma.$executeRaw`DELETE FROM \"sales_invoice\" WHERE \"id\" = ${testInv.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+});\r\n"}}}
