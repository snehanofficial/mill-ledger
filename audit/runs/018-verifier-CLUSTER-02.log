{"event":"step_update","step_update":{"conversation_id":"7d2c8f70-136b-42b7-9207-a2300dac13ec","step_index":36,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.140554748,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git show 7c81a65"},"output":"Created At: 2026-11-23T01:37:05+05:30\nCompleted At: 2026-11-23T01:37:05+05:30\nCommand exited with code 0.\n\nCommand output:\ncommit 7c81a65d49ae7d10d3b028e13cea071e7e0fd22e (tag: pre-CLUSTER-02-a5, tag: pre-CLUSTER-02-a4)\r\nAuthor: Snehan S \u003csnehankgs@gmail.com\u003e\r\nDate:   Sun Nov 22 23:49:05 2026 +0530\r\n\r\n    F-007: Missing row-level lock in sales order approval allows concurrent orders to exceed ATP stock by over 100%\r\n\r\ndiff --git a/server/src/modules/sales/sales.service.ts b/server/src/modules/sales/sales.service.ts\r\nindex 0628853..e103bc8 100644\r\n--- a/server/src/modules/sales/sales.service.ts\r\n+++ b/server/src/modules/sales/sales.service.ts\r\n@@ -399,6 +399,25 @@ export class SalesService {\r\n       // Track whether admin changed price or quantity\r\n       let hasOverrides = false;\r\n \r\n+      // Acquire row-level locks on all involved inventory items in deterministic order (prevents concurrent overselling \u0026 deadlocks - F-007)\r\n+      const involvedItemIds = [\r\n+        ...new Set(\r\n+          order.lines\r\n+            .map((l) =\u003e l.inventoryItemId)\r\n+            .filter((id): id is string =\u003e Boolean(id)),\r\n+        ),\r\n+      ].sort();\r\n+\r\n+      const lockedItems = new Map\u003cstring, number\u003e();\r\n+      for (const itemId of involvedItemIds) {\r\n+        const rows = await tx.$queryRaw\u003c\r\n+          Array\u003c{ id: string; currentStock: unknown }\u003e\r\n+        \u003e`SELECT id, \"currentStock\" FROM \"inventory_item\" WHERE id = ${itemId} FOR UPDATE`;\r\n+        if (rows[0]) {\r\n+          lockedItems.set(itemId, Number(rows[0].currentStock));\r\n+        }\r\n+      }\r\n+\r\n      