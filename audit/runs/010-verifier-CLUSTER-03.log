{"event":"step_update","step_update":{"conversation_id":"3b1198c2-3bc4-43fe-9186-cbcd404239b5","step_index":129,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.057025061,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff bfd9d04..ba71207"},"output":"Created At: 2026-11-22T21:52:35+05:30\nCompleted At: 2026-11-22T21:52:35+05:30\nCommand exited with code 0.\n\nCommand output:\ndiff --git a/server/prisma/migrations/20261120000002_ledger_immutability_triggers/migration.sql b/server/prisma/migrations/20261120000002_ledger_immutability_triggers/migration.sql\r\nindex 13dbfd6..48015f3 100644\r\n--- a/server/prisma/migrations/20261120000002_ledger_immutability_triggers/migration.sql\r\n+++ b/server/prisma/migrations/20261120000002_ledger_immutability_triggers/migration.sql\r\n@@ -40,6 +40,7 @@ BEGIN\r\n \r\n   IF TG_OP = 'UPDATE' THEN\r\n     IF OLD.status IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') THEN\r\n+      -- Block financial and identification field mutation\r\n       IF (OLD.\"totalAmount\" IS DISTINCT FROM NEW.\"totalAmount\") OR\r\n          (OLD.\"taxableAmount\" IS DISTINCT FROM NEW.\"taxableAmount\") OR\r\n          (OLD.\"cgstAmount\" IS DISTINCT FROM NEW.\"cgstAmount\") OR\r\n@@ -52,6 +53,17 @@ BEGIN\r\n          (OLD.\"organizationId\" IS DISTINCT FROM NEW.\"organizationId\") THEN\r\n         RAISE EXCEPTION 'Posted sales invoice financial and identification fields are immutable';\r\n       END IF;\r\n+      -- Block snapshot field mutation (forgery prevention)\r\n+      IF (OLD.\"customerNameSnapshot\" IS DISTINCT FROM NEW.\"customerNameSnapshot\") OR\r\n+         (OLD.\"companyGstinSnapshot\" IS DISTINCT FROM NEW.\"companyGstinSnapshot\") OR\r\n+         (OLD.\"deliveryStateSnapshot\" IS DISTINCT FROM NEW.\"deliveryStateSnapshot\") THEN\r\n+        RAISE EXCEPTION 'Posted sales invoice snapshot fields are immutable';\r\n+      END IF;\r\n+      -- Block status downgrade (POSTED/PAID/etc -\u003e DRAFT would allow DELETE bypass)\r\n+      IF OLD.status IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') AND\r\n+         NEW.status NOT IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') THEN\r\n+        RAISE EXCEPTION 'Posted sales invoice status cannot be downgraded from % to %', OLD.status, NEW.status;\r\n+      END IF;\r\n     END IF;\r\n     RETURN NEW;\r\n   END IF;\r\n@@ -66,6 +78,7 @@ BEFORE UPDATE OR DELETE ON \"sales_invoice\"\r\n FOR EACH ROW EXECUTE FUNCTION enforce_sales_invoice_immutability();\r\n \r\n -- Trigger to enforce immutability on lines of posted sales_invoice\r\n+-- NOTE: The FK column on sales_invoice_line is \"invoiceId\" (not \"salesInvoiceId\")\r\n CREATE OR REPLACE FUNCTION enforce_sales_invoice_line_immutability()\r\n RETURNS TRIGGER AS $$\r\n DECLARE\r\n@@ -79,7 +92,7 @@ BEGIN\r\n     END IF;\r\n   END IF;\r\n \r\n-  SELECT status INTO v_status FROM \"sales_invoice\" WHERE id = COALESCE(OLD.\"salesInvoiceId\", NEW.\"salesInvoiceId\");\r\n+  SELECT status INTO v_status FROM \"sales_invoice\" WHERE id = COALESCE(OLD.\"invoiceId\", NEW.\"invoiceId\");\r\n   IF v_status IN ('POSTED', 'PARTIALLY_PAID', 'PAID', 'CANCELLED_BY_CREDIT_NOTE') THEN\r\n     RAISE EXCEPTION 'Lines belonging to posted sales invoices are immutable';\r\n   END IF;\r\ndiff --git a/server/src/db-immutability.test.ts b/server/src/db-immutability.test.ts\r\nindex 0bd2924..2430f00 100644\r\n--- a/server/src/db-immutability.test.ts\r\n+++ b/server/src/db-immutability.test.ts\r\n@@ -19,6 +19,7 @@ describe(\"F-009: Database-Level Immutability Enforcement\", () =\u003e {\r\n   afterAll(async () =\u003e {\r\n     await resetOperationalData();\r\n   });\r\n+\r\n   it(\"rejects direct SQL UPDATE on stock_movement\", async () =\u003e {\r\n     const sm = await prisma.stockMovement.findFirst();\r\n     expect(sm).toBeDefined();\r\n@@ -30,7 +31,6 @@ describe(\"F-009: Database-Level Immutability Enforcement\", () =\u003e {\r\n   });\r\n \r\n   it(\"rejects direct SQL DELETE on stock_movement\", async () =\u003e {\r\n-    // Create a temporary movement to attempt deleting\r\n     const item = await prisma.inventoryItem.findFirstOrThrow();\r\n     const wh = await prisma.warehouse.findFirstOrThrow();\r\n \r\n@@ -108,4 +108,162 @@ describe(\"F-009: Database-Level Immutability Enforcement\", () =\u003e {\r\n       prisma.$executeRaw`DELETE FROM \"sales_invoice\" WHERE \"id\" = ${testInv.id}`\r\n     ).rejects.toThrow();\r\n   });\r\n+\r\n+  it(\"rejects status downgrade from POSTED to DRAFT on sales_invoice\", async () =\u003e {\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    const cust = await prisma.customer.findFirstOrThrow();\r\n+\r\n+    const testInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: org.id,\r\n+        invoiceNumber: `INV-DOWNGRADE-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: cust.id,\r\n+        customerNameSnapshot: cust.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 5,\r\n+        totalAmount: 105,\r\n+        outstandingAmount: 105,\r\n+      },\r\n+    });\r\n+\r\n+    // Status downgrade must be blocked\r\n+    await expect(\r\n+      prisma.$executeRaw`UPDATE \"sales_invoice\" SET \"status\" = 'DRAFT' WHERE \"id\" = ${testInv.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+\r\n+  it(\"rejects mutation of snapshot fields on POSTED sales_invoice\", async () =\u003e {\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    const cust = await prisma.customer.findFirstOrThrow();\r\n+\r\n+    const testInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: org.id,\r\n+        invoiceNumber: `INV-SNAPSHOT-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: cust.id,\r\n+        customerNameSnapshot: cust.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 5,\r\n+        totalAmount: 105,\r\n+        outstandingAmount: 105,\r\n+      },\r\n+    });\r\n+\r\n+    // Forging GSTIN snapshot must be blocked\r\n+    await expect(\r\n+      prisma.$executeRaw`UPDATE \"sales_invoice\" SET \"companyGstinSnapshot\" = 'FORGED123' WHERE \"id\" = ${testInv.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+\r\n+  it(\"rejects DELETE on a line belonging to a POSTED sales_invoice\", async () =\u003e {\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    const cust = await prisma.customer.findFirstOrThrow();\r\n+    const variant = await prisma.productVariant.findFirstOrThrow();\r\n+\r\n+    const testInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: org.id,\r\n+        invoiceNumber: `INV-LINE-DEL-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: cust.id,\r\n+        customerNameSnapshot: cust.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 5,\r\n+        totalAmount: 105,\r\n+        outstandingAmount: 105,\r\n+      },\r\n+    });\r\n+\r\n+    const testLine = await prisma.salesInvoiceLine.create({\r\n+      data: {\r\n+        invoiceId: testInv.id,\r\n+        productVariantId: variant.id,\r\n+        productNameSnapshot: variant.name,\r\n+        hsnCodeSnapshot: \"21069099\",\r\n+        quantity: 10,\r\n+        unitPrice: 10,\r\n+        taxRate: 5,\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        taxAmount: 5,\r\n+        lineTotal: 105,\r\n+      },\r\n+    });\r\n+\r\n+    // DELETE on line of a POSTED invoice must be blocked\r\n+    await expect(\r\n+      prisma.$executeRaw`DELETE FROM \"sales_invoice_line\" WHERE \"id\" = ${testLine.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n+\r\n+  it(\"rejects UPDATE on a line belonging to a POSTED sales_invoice\", async () =\u003e {\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    const cust = await prisma.customer.findFirstOrThrow();\r\n+    const variant = await prisma.productVariant.findFirstOrThrow();\r\n+\r\n+    const testInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: org.id,\r\n+        invoiceNumber: `INV-LINE-UPD-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: cust.id,\r\n+        customerNameSnapshot: cust.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 5,\r\n+        totalAmount: 105,\r\n+        outstandingAmount: 105,\r\n+      },\r\n+    });\r\n+\r\n+    const testLine = await prisma.salesInvoiceLine.create({\r\n+      data: {\r\n+        invoiceId: testInv.id,\r\n+        productVariantId: variant.id,\r\n+        productNameSnapshot: variant.name,\r\n+        hsnCodeSnapshot: \"21069099\",\r\n+        quantity: 10,\r\n+        unitPrice: 10,\r\n+        taxRate: 5,\r\n+        taxableAmount: 100,\r\n+        cgstAmount: 2.5,\r\n+        sgstAmount: 2.5,\r\n+        igstAmount: 0,\r\n+        taxAmount: 5,\r\n+        lineTotal: 105,\r\n+      },\r\n+    });\r\n+\r\n+    // UPDATE on line of a POSTED invoice must be blocked\r\n+    await expect(\r\n+      prisma.$executeRaw`UPDATE \"sales_invoice_line\" SET \"lineTotal\" = 9999 WHERE \"id\" = ${testLine.id}`\r\n+    ).rejects.toThrow();\r\n+  });\r\n });\r\n"}}}
