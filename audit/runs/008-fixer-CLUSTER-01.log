{"event":"step_update","step_update":{"conversation_id":"4decca04-533e-46ee-9d54-184914f65ac5","step_index":15,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.065441777,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git diff --cached"},"output":"Created At: 2026-11-22T20:55:50+05:30\nCompleted At: 2026-11-22T20:55:50+05:30\nCommand exited with code 0.\n\nCommand output:\ndiff --git a/server/prisma/schema.prisma b/server/prisma/schema.prisma\r\nindex 425948b..79e2aa5 100644\r\n--- a/server/prisma/schema.prisma\r\n+++ b/server/prisma/schema.prisma\r\n@@ -97,6 +97,7 @@ model Organization {\r\n   dispatches     Dispatch[]\r\n   creditNotes    CreditNote[]\r\n   payments       Payment[]\r\n+  debitNotes     DebitNote[]\r\n   auditLogs      AuditLog[]\r\n   users          User[]\r\n   documentSequences DocumentSequence[]\r\n@@ -832,6 +833,7 @@ enum PaymentMode {\r\n enum PaymentStatus {\r\n   POSTED\r\n   CANCELLED\r\n+  BOUNCED\r\n }\r\n \r\n model Payment {\r\n@@ -854,6 +856,7 @@ model Payment {\r\n   updatedAt         DateTime          @updatedAt\r\n \r\n   allocations       PaymentAllocation[]\r\n+  debitNotes        DebitNote[]\r\n \r\n   @@unique([organizationId, paymentNumber])\r\n   @@index([organizationId, customerId])\r\n@@ -877,6 +880,26 @@ model PaymentAllocation {\r\n   @@map(\"payment_allocation\")\r\n }\r\n \r\n+// Debit note for supplier returns and customer debit adjustments (OD-06)\r\n+model DebitNote {\r\n+  id             String       @id @default(cuid())\r\n+  organizationId String\r\n+  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)\r\n+  debitNoteNumber String\r\n+  paymentId      String?\r\n+  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)\r\n+  reason         String\r\n+  amount         Decimal      @db.Decimal(18, 2)\r\n+  notes          String?\r\n+  postedAt       DateTime     @default(now())\r\n+  createdAt      DateTime     @default(now())\r\n+  updatedAt      DateTime     @updatedAt\r\n+\r\n+  @@unique([organizationId, debitNoteNumber])\r\n+  @@index([organizationId])\r\n+  @@map(\"debit_note\")\r\n+}\r\n+\r\n model AuditLog {\r\n   id             String       @id @default(cuid())\r\n   organizationId String\r\ndiff --git a/server/src/payment-bounce.test.ts b/server/src/payment-bounce.test.ts\r\nnew file mode 100644\r\nindex 0000000..d5c58d8\r\n--- /dev/null\r\n+++ b/server/src/payment-bounce.test.ts\r\n@@ -0,0 +1,146 @@\r\n+/**\r\n+ * F-013 Regression Test: Payment bounce/reversal and PaymentStatus.BOUNCED\r\n+ *\r\n+ * Tests that:\r\n+ * 1. bouncePayment() atomically marks payment BOUNCED and restores invoice outstandingAmount\r\n+ * 2. Invoice status reverts to POSTED (or PARTIALLY_PAID) after bounce\r\n+ * 3. PaymentStatus.BOUNCED exists in the Prisma enum\r\n+ * 4. Bouncing an already-bounced payment throws\r\n+ */\r\n+import { afterAll, beforeAll, describe, expect, it } from \"vitest\";\r\n+import { InvoiceStatus, PaymentStatus } from \"@prisma/client\";\r\n+import { paymentService } from \"./modules/finance/payment.service.js\";\r\n+import { prisma } from \"./db/client.js\";\r\n+import { seedBenchmarkMasters } from \"./db/seed.js\";\r\n+import { resetOperationalData } from \"./db/reset.js\";\r\n+\r\n+describe(\"F-013: Payment bounce/reversal and PaymentStatus.BOUNCED\", () =\u003e {\r\n+  let orgId: string;\r\n+  let customerId: string;\r\n+  let invoiceId: string;\r\n+  let totalAmount: number;\r\n+\r\n+  beforeAll(async () =\u003e {\r\n+    await resetOperationalData();\r\n+    await seedBenchmarkMasters();\r\n+\r\n+    const org = await prisma.organization.findFirstOrThrow();\r\n+    orgId = org.id;\r\n+    const customer = await prisma.customer.findFirstOrThrow({\r\n+      where: { code: \"CUST-RET-A\" },\r\n+    });\r\n+    customerId = customer.id;\r\n+\r\n+    // Create a minimal POSTED invoice directly for testing\r\n+    const inv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: orgId,\r\n+        invoiceNumber: `INV-BOUNCE-TEST-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: customer.id,\r\n+        customerNameSnapshot: customer.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 1000,\r\n+        cgstAmount: 25,\r\n+        sgstAmount: 25,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 50,\r\n+        totalAmount: 1050,\r\n+        paidAmount: 0,\r\n+        outstandingAmount: 1050,\r\n+      },\r\n+    });\r\n+    invoiceId = inv.id;\r\n+    totalAmount = 1050;\r\n+  });\r\n+\r\n+  afterAll(async () =\u003e {\r\n+    await resetOperationalData();\r\n+  });\r\n+\r\n+  it(\"PaymentStatus enum includes BOUNCED value\", () =\u003e {\r\n+    // This will fail to compile/import if BOUNCED is not in the Prisma schema\r\n+    const bounced: PaymentStatus = PaymentStatus.BOUNCED;\r\n+    expect(bounced).toBe(\"BOUNCED\");\r\n+  });\r\n+\r\n+  it(\"bouncePayment() restores invoice outstanding amount and status to POSTED after a full-payment bounce\", async () =\u003e {\r\n+    // Record a full payment\r\n+    const payment = await paymentService.recordPayment({\r\n+      organizationId: orgId,\r\n+      customerId,\r\n+      amount: totalAmount,\r\n+      idempotencyKey: `BOUNCE-FULL-${Date.now()}`,\r\n+      allocations: [{ salesInvoiceId: invoiceId, amount: totalAmount }],\r\n+    });\r\n+\r\n+    // Verify invoice is now PAID\r\n+    const invoiceAfterPay = await prisma.salesInvoice.findUniqueOrThrow({\r\n+      where: { id: invoiceId },\r\n+    });\r\n+    expect(invoiceAfterPay.status).toBe(InvoiceStatus.PAID);\r\n+    expect(Number(invoiceAfterPay.outstandingAmount)).toBe(0);\r\n+\r\n+    // Bounce the payment\r\n+    const bounced = await paymentService.bouncePayment(\r\n+      payment.id,\r\n+      \"Cheque dishonoured by bank\",\r\n+    );\r\n+\r\n+    // Payment is BOUNCED\r\n+    expect(bounced.status).toBe(PaymentStatus.BOUNCED);\r\n+\r\n+    // Invoice is restored to POSTED with original outstanding\r\n+    const invoiceAfterBounce = await prisma.salesInvoice.findUniqueOrThrow({\r\n+      where: { id: invoiceId },\r\n+    });\r\n+    expect(invoiceAfterBounce.status).toBe(InvoiceStatus.POSTED);\r\n+    expect(Number(invoiceAfterBounce.outstandingAmount)).toBeCloseTo(\r\n+      totalAmount,\r\n+      2,\r\n+    );\r\n+  });\r\n+\r\n+  it(\"bouncePayment() throws error if payment is already BOUNCED\", async () =\u003e {\r\n+    // Create a fresh invoice for this test\r\n+    const customer = await prisma.customer.findFirstOrThrow({\r\n+      where: { code: \"CUST-RET-A\" },\r\n+    });\r\n+    const freshInv = await prisma.salesInvoice.create({\r\n+      data: {\r\n+        organizationId: orgId,\r\n+        invoiceNumber: `INV-BOUNCE-DOUBLE-${Date.now()}`,\r\n+        financialYear: \"2026-27\",\r\n+        customerId: customer.id,\r\n+        customerNameSnapshot: customer.name,\r\n+        deliveryStateSnapshot: \"Tamil Nadu\",\r\n+        companyGstinSnapshot: \"33AAAAA0000A1Z5\",\r\n+        status: \"POSTED\",\r\n+        taxableAmount: 500,\r\n+        cgstAmount: 12.5,\r\n+        sgstAmount: 12.5,\r\n+        igstAmount: 0,\r\n+        totalTaxAmount: 25,\r\n+        totalAmount: 525,\r\n+        paidAmount: 0,\r\n+        outstandingAmount: 525,\r\n+      },\r\n+    });\r\n+\r\n+    const payment = await paymentService.recordPayment({\r\n+      organizationId: orgId,\r\n+      customerId: customer.id,\r\n+      amount: 525,\r\n+      idempotencyKey: `BOUNCE-DOUBLE-${Date.now()}`,\r\n+      allocations: [{ salesInvoiceId: freshInv.id, amount: 525 }],\r\n+    });\r\n+\r\n+    await paymentService.bouncePayment(payment.id, \"First bounce\");\r\n+\r\n+    await expect(\r\n+      paymentService.bouncePayment(payment.id, \"Second bounce attempt\"),\r\n+    ).rejects.toThrow();\r\n+  });\r\n+});\r\n"}}}
