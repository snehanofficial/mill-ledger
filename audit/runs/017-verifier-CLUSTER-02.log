{"event":"step_update","step_update":{"conversation_id":"5be73a3a-589c-4146-924f-53bb37cfe144","step_index":16,"state":"DONE","step_type":"tool","tool_name":"run_command","duration_seconds":0.073308011,"tool_info":{"name":"run_command","parameters":{"CommandLine":"git show 7c81a65"},"output":"Created At: 2026-11-23T01:06:19+05:30\nCompleted At: 2026-11-23T01:06:19+05:30\nCommand exited with code 0.\n\nCommand output:\ncommit 7c81a65d49ae7d10d3b028e13cea071e7e0fd22e (tag: pre-CLUSTER-02-a5, tag: pre-CLUSTER-02-a4)\r\nAuthor: Snehan S \u003csnehankgs@gmail.com\u003e\r\nDate:   Sun Nov 22 23:49:05 2026 +0530\r\n\r\n    F-007: Missing row-level lock in sales order approval allows concurrent orders to exceed ATP stock by over 100%\r\n\r\ndiff --git a/server/src/modules/sales/sales.service.ts b/server/src/modules/sales/sales.service.ts\r\nindex 0628853..e103bc8 100644\r\n--- a/server/src/modules/sales/sales.service.ts\r\n+++ b/server/src/modules/sales/sales.service.ts\r\n@@ -399,6 +399,25 @@ export class SalesService {\r\n       // Track whether admin changed price or quantity\r\n       let hasOverrides = false;\r\n \r\n+      // Acquire row-level locks on all involved inventory items in deterministic order (prevents concurrent overselling \u0026 deadlocks - F-007)\r\n+      const involvedItemIds = [\r\n+        ...new Set(\r\n+          order.lines\r\n+            .map((l) =\u003e l.inventoryItemId)\r\n+            .filter((id): id is string =\u003e Boolean(id)),\r\n+        ),\r\n+      ].sort();\r\n+\r\n+      const lockedItems = new Map\u003cstring, number\u003e();\r\n+      for (const itemId of involvedItemIds) {\r\n+        const rows = await tx.$queryRaw\u003c\r\n+          Array\u003c{ id: string; currentStock: unknown }\u003e\r\n+        \u003e`SELECT id, \"currentStock\" FROM \"inventory_item\" WHERE id = ${itemId} FOR UPDATE`;\r\n+        if (rows[0]) {\r\n+          lockedItems.set(itemId, Number(rows[0].currentStock));\r\n+        }\r\n+      }\r\n+\r\n       for (const line of order.lines) {\r\n         const override = input.lineOverrides?.find((o) =\u003e o.lineId === line.id);\r\n         const approvedQty = override\r\n@@ -425,10 +444,7 @@ export class SalesService {\r\n \r\n         // Verify stock availability\r\n         if (line.inventoryItemId) {\r\n-          const invItem = await tx.inventoryItem.findUnique({\r\n-            where: { id: line.inventoryItemId },\r\n-          });\r\n-          const onHand = Number(invItem?.currentStock ?? 0);\r\n+          const onHand = lockedItems.get(line.inventoryItemId) ?? 0;\r\n \r\n           const resAgg = await tx.stockReservation.aggregate({\r\n             where: {\r\ndiff --git a/server/src/sales-concurrency.test.ts b/server/src/sales-concurrency.test.ts\r\nnew file mode 100644\r\nindex 0000000..8f3f680\r\n--- /dev/null\r\n+++ b/server/src/sales-concurrency.test.ts\r\n@@ -0,0 +1,170 @@\r\n+import { afterAll, beforeAll, describe, expect, it } from \"vitest\";\r\n+import { prisma } from \"./db/client.js\";\r\n+import { seedBenchmarkMasters } from \"./db/seed.js\";\r\n+import { salesService } from \"./modules/sales/sales.service.js\";\r\n+import type { UserContext } from \"@mill-ledger/shared\";\r\n+\r\n+describe(\"F-007: Concurrency race condition in sales order approval (ATP stock overselling)\", () =\u003e {\r\n+  let adminUser: UserContext;\r\n+  let orgId: string;\r\n+  let warehouseId: string;\r\n+  let customerId: string;\r\n+  let uomId: string;\r\n+  const createdInvItemIds: string[] = [];\r\n+  const createdOrderIds: string[] = [];\r\n+\r\n+  beforeAll(async () =\u003e {\r\n+    await seedBenchmarkMasters();\r\n+\r\n+    const adminDb = await prisma.user.findFirstOrThrow({\r\n+      where: { role: \"ADMIN\" },\r\n+    });\r\n+    adminUser = {\r\n+      id: adminDb.id,\r\n+      email: adminDb.email,\r\n+      role: \"ADMIN\",\r\n+      isActive: adminDb.isActive,\r\n+      organizationId: adminDb.organizationId ?? undefined,\r\n+    };\r\n+\r\n+    const org = await prisma.organization.findUniqueOrThrow({\r\n+      where: { code: \"MILL\" },\r\n+    });\r\n+    orgId = org.id;\r\n+\r\n+    const wh = await prisma.warehouse.findFirstOrThrow({\r\n+      where: { facility: { organizationId: orgId } },\r\n+    });\r\n+    warehouseId = wh.id;\r\n+\r\n+    const cust = await prisma.customer.findFirstOrThrow({\r\n+      where: { organizationId: orgId },\r\n+    });\r\n+    customerId = cust.id;\r\n+\r\n+    const uom = await prisma.unitOfMeasure.findFirstOrThrow({\r\n+      where: { code: \"PACKET\" },\r\n+    });\r\n+    uomId = uom.id;\r\n+  });\r\n+\r\n+  afterAll(async () =\u003e {\r\n+    // Teardown test artifacts\r\n+    await prisma.$transaction(async (tx) =\u003e {\r\n+      await tx.$executeRawUnsafe(\"SET LOCAL mill_ledger.bypass_immutability = 'on'\");\r\n+      if (createdOrderIds.length \u003e 0) {\r\n+        await tx.stockReservation.deleteMany({\r\n+          where: { salesOrderId: { in: createdOrderIds } },\r\n+        });\r\n+        await tx.salesOrderLine.deleteMany({\r\n+          where: { salesOrderId: { in: createdOrderIds } },\r\n+        });\r\n+        await tx.salesOrder.deleteMany({\r\n+          where: { id: { in: createdOrderIds } },\r\n+        });\r\n+      }\r\n+      if (createdInvItemIds.length \u003e 0) {\r\n+        await tx.productVariant.deleteMany({\r\n+          where: { inventoryItemId: { in: createdInvItemIds } },\r\n+        });\r\n+        await tx.inventoryItem.deleteMany({\r\n+          where: { id: { in: createdInvItemIds } },\r\n+        });\r\n+      }\r\n+    });\r\n+  });\r\n+\r\n+  it(\"prevents overselling when 20 concurrent approval requests compete for 50 available units\", async () =\u003e {\r\n+    // Setup isolated inventory item with currentStock = 50\r\n+    const sku = `CONC-ATP-${Date.now()}`;\r\n+    const invItem = await prisma.inventoryItem.create({\r\n+      data: {\r\n+        organizationId: orgId,\r\n+        sku,\r\n+        name: `ATP Concurrency Test Item`,\r\n+        category: \"FINISHED_GOODS\",\r\n+        baseUomId: uomId,\r\n+        currentStock: 50.0,\r\n+        weightedAverageCost: 20.0,\r\n+      },\r\n+    });\r\n+    createdInvItemIds.push(invItem.id);\r\n+\r\n+    const prd = await prisma.product.create({\r\n+      data: {\r\n+        organizationId: orgId,\r\n+        code: `PRD-${sku}`,\r\n+        name: `Product ${sku}`,\r\n+        taxRate: 5.0,\r\n+        hsnCode: \"21069099\",\r\n+      },\r\n+    });\r\n+\r\n+    const variant = await prisma.productVariant.create({\r\n+      data: {\r\n+        productId: prd.id,\r\n+        sku: `VAR-${sku}`,\r\n+        name: `Variant ${sku}`,\r\n+        uomId,\r\n+        inventoryItemId: invItem.id,\r\n+        packSize: 0.2,\r\n+      },\r\n+    });\r\n+\r\n+    // Create 20 SUBMITTED sales orders requesting 10 units each (total demand: 200, available: 50)\r\n+    const orderCount = 20;\r\n+    const qtyPerOrder = 10;\r\n+    const orders = [];\r\n+\r\n+    for (let i = 0; i \u003c orderCount; i++) {\r\n+      const res = await salesService.createSalesOrder(\r\n+        {\r\n+          organizationId: orgId,\r\n+          customerId,\r\n+          warehouseId,\r\n+          orderNumber: `SO-ATP-${Date.now()}-${i}`,\r\n+          lines: [\r\n+            {\r\n+              productVariantId: variant.id,\r\n+              quantity: qtyPerOrder,\r\n+              unitPrice: 50,\r\n+            },\r\n+          ],\r\n+        },\r\n+        adminUser,\r\n+      );\r\n+      orders.push(res.order);\r\n+      createdOrderIds.push(res.order.id);\r\n+    }\r\n+\r\n+    // Fire 20 parallel approval requests simultaneously\r\n+    const approvePromises = orders.map((o) =\u003e\r\n+      salesService\r\n+        .approveSalesOrder(o.id, {}, adminUser)\r\n+        .then(() =\u003e ({ success: true, orderId: o.id, error: null }))\r\n+        .catch((err) =\u003e ({ success: false, orderId: o.id, error: err.message })),\r\n+    );\r\n+\r\n+    const results = await Promise.all(approvePromises);\r\n+    const approvedCount = results.filter((r) =\u003e r.success).length;\r\n+    const rejectedCount = results.filter((r) =\u003e !r.success).length;\r\n+\r\n+    // Check total active stock reservations created\r\n+    const resAgg = await prisma.stockReservation.aggregate({\r\n+      where: {\r\n+        inventoryItemId: invItem.id,\r\n+        status: \"ACTIVE\",\r\n+      },\r\n+      _sum: {\r\n+        reservedQuantity: true,\r\n+      },\r\n+    });\r\n+    const totalReserved = Number(resAgg._sum.reservedQuantity ?? 0);\r\n+\r\n+    // With 50 available units and 10 units per order, at most 5 orders can be approved.\r\n+    // Total reserved MUST NEVER exceed 50.\r\n+    expect(totalReserved).toBeLessThanOrEqual(50);\r\n+    expect(approvedCount).toBeLessThanOrEqual(5);\r\n+    expect(approvedCount + rejectedCount).toBe(20);\r\n+  });\r\n+});\r\n"}}}
