{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "ignore": ["audit/**", "node_modules/**", "dist/**", "**/dist/**"],
  "workspaces": {
    "client": {
      "entry": ["src/main.tsx", "src/sw.ts", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "server": {
      "entry": ["src/index.ts", "prisma/seed.ts"],
      "project": ["src/**/*.ts", "prisma/**/*.ts"]
    },
    "shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
