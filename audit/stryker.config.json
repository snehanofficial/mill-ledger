{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "mutate": [
    "server/src/modules/finance/payment.service.ts:75-150"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm vitest run server/src/payments.test.ts --exclude '**/audit/**'"
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "audit/evidence/quality/stryker-report-payments.json"
  },
  "concurrency": 1,
  "timeoutMS": 45000,
  "tempDirName": "audit/scratch/.stryker-tmp"
}
